<?xml version="1.0"?>
<robot name="asn_robot">

  <link name="base_link"/>
  <link name="laser_frame"/>
  <link name="camera_link"/>
  <link name="camera_optical_frame"/>
  <link name="wheel_drop_left">
    <inertial>
      <mass value="0.0500000007"/>
      <inertia ixx="2.08333331e-05" ixy="0" ixz="0" iyy="2.08333331e-05" iyz="0" izz="2.08333331e-05"/>
    </inertial>
  </link>
  <link name="wheel_drop_right">
    <inertial>
      <mass value="0.0500000007"/>
      <inertia ixx="2.08333331e-05" ixy="0" ixz="0" iyy="2.08333331e-05" iyz="0" izz="2.08333331e-05"/>
    </inertial>
  </link>
  <link name="left_wheel">
    <inertial>
      <mass value="0.200000003"/>
      <inertia ixx="6.76531272e-05" ixy="0" ixz="0" iyy="6.76531272e-05" iyz="0" izz="0.000127806255"/>
    </inertial>
    <visual name="visuals">
      <origin xyz="0 0 0" rpy="0 -1.57079627 0"/>
      <geometry>
        <cylinder radius="0.0357500017" length="0.0149999997"/>
      </geometry>
    </visual>
    <collision name="collisions">
      <origin xyz="0 0 0" rpy="0 -1.57079627 0"/>
      <geometry>
        <cylinder radius="0.0357500017" length="0.0149999997"/>
      </geometry>
    </collision>
  </link>
  <link name="right_wheel">
    <inertial>
      <mass value="0.200000003"/>
      <inertia ixx="6.76531272e-05" ixy="0" ixz="0" iyy="6.76531272e-05" iyz="0" izz="0.000127806255"/>
    </inertial>
    <visual name="visuals">
      <origin xyz="0 0 0" rpy="0 -1.57079627 0"/>
      <geometry>
        <cylinder radius="0.0357500017" length="0.0149999997"/>
      </geometry>
    </visual>
    <collision name="collisions">
      <origin xyz="0 0 0" rpy="0 -1.57079627 0"/>
      <geometry>
        <cylinder radius="0.0357500017" length="0.0149999997"/>
      </geometry>
    </collision>
  </link>




  <joint name="wheel_drop_left_joint" type="prismatic">
    <origin xyz="0 0.116499998 0.0401999988" rpy="0 -1.57079624 1.57079627"/>
    <parent link="base_link"/>
    <child link="wheel_drop_left"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="0.0299999993" effort="3.40282347e+38" velocity="0.1"/>
    <dynamics friction="0.100000001"/>
  </joint>
  <joint name="wheel_drop_right_joint" type="prismatic">
    <origin xyz="0 -0.116499998 0.0401999988" rpy="0 -1.57079624 1.57079627"/>
    <parent link="base_link"/>
    <child link="wheel_drop_right"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="0.0299999993" effort="3.40282347e+38" velocity="0.1"/>
    <dynamics friction="0.100000001"/>
  </joint>
  <joint name="left_wheel_joint" type="continuous">
    <origin xyz="0 0 0" rpy="0 -1.57079623 1.57079627"/>
    <parent link="wheel_drop_left"/>
    <child link="left_wheel"/>
    <axis xyz="-1 0 0"/>
    <limit effort="3.40282347e+38" velocity="0.1" />
    <dynamics friction="0"/>
  </joint>
  <joint name="right_wheel_joint" type="continuous">
    <origin xyz="0 0 0" rpy="0 -1.57079623 1.57079627"/>
    <parent link="wheel_drop_right"/>
    <child link="right_wheel"/>
    <axis xyz="-1 0 0"/>
    <limit effort="3.40282347e+38" velocity="0.1"/>
    <dynamics friction="0"/>
  </joint>
  <joint name="base_to_laser" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="-0.04 0 0.193" rpy="0 0 0"/>
  </joint>
  <joint name="base_to_camera_link" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
  </joint>
  <joint name="camera_link_to_camera_frame" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/>
  </joint>


  
</robot>